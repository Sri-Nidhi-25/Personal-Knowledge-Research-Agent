# Application Configuration
APP_NAME=Personal Knowledge Research Agent
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Storage Paths
DATA_DIR=data
DOCUMENTS_DIR=data/documents
CHROMA_DIR=data/chroma
DATABASE_URL=sqlite:///data/database/app.db
KNOWLEDGE_DIR=data/knowledge

# LLM Configuration (mock, openai, groq, gemini, ollama)
LLM_PROVIDER=mock
LLM_MODEL=default
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2

# Embedding Configuration (hash, fastembed, sentence-transformers, openai)
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=default
EMBEDDING_DIM=384

# Web Search Configuration (mock, tavily, duckduckgo)
SEARCH_PROVIDER=mock
SEARCH_API_KEY=

# Research Safety Budgets
MAX_RESEARCH_ITERATIONS=8
MAX_SEARCH_QUERIES=15
MAX_SOURCES_PER_RUN=10
MAX_FETCHES_PER_RUN=15
MAX_RUNTIME_MINUTES=10
FETCH_TIMEOUT_SECONDS=15
MAX_CONTENT_LENGTH_BYTES=1000000
